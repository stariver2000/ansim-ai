# 별돌봄 도구 호출용 GBNF grammar
# llama.cpp --grammar-file 옵션과 함께 사용
# 폰 sLLM (Gemma 3 1B / Qwen2.5-1.5B)이 유효한 도구 호출 JSON만 생성하도록 강제

root         ::= ws "{" ws "\"tool\":" ws tool-name ws "," ws "\"args\":" ws args ws "}" ws

tool-name    ::= "\"call_contact\""
               | "\"send_sms_contact\""
               | "\"video_call_family\""
               | "\"call_emergency\""
               | "\"scam_check_text\""
               | "\"scam_check_screen\""
               | "\"scam_check_call\""
               | "\"guide_card_show\""
               | "\"app_guide_start\""
               | "\"app_guide_step_next\""
               | "\"medication_log_check\""
               | "\"medication_log_add\""
               | "\"today_summary\""
               | "\"weather_today\""
               | "\"app_open\""
               | "\"web_search\""
               | "\"map_navigate\""
               | "\"call_family_for_help\""
               | "\"notify_family_silent\""
               | "\"clarify\""

args         ::= "{" ws (kv (ws "," ws kv)*)? ws "}"
kv           ::= string ws ":" ws value
value        ::= string | number | bool | array
string       ::= "\"" char* "\""
char         ::= [^"\\] | "\\" ["\\/bfnrt]
number       ::= "-"? [0-9]+ ("." [0-9]+)?
bool         ::= "true" | "false"
array        ::= "[" ws (value (ws "," ws value)*)? ws "]"
ws           ::= [ \t\n]*
